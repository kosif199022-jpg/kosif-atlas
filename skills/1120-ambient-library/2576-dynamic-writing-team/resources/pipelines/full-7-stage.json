{
  "pipeline_id": "full-7-stage",
  "name": "Full Pipeline",
  "description": "Default flow with all 10 roles across 7 stages. Includes Analogist, Emotional Architect, and Compression Agent.",
  "best_for": ["thought-leadership-article", "blog", "how-to-tutorial"],
  "stages": [
    {
      "stage": 1,
      "name": "Strategy",
      "roles": ["strategist"],
      "parallel": false,
      "gate": { "min_score": 7, "action": "send_back" }
    },
    {
      "stage": 2,
      "name": "Research + Reaction + Frame",
      "roles": ["researcher", "avatar-reviewer:pass-1", "analogist"],
      "parallel": true,
      "gate": {
        "researcher": { "source_verification_min": 9, "action": "block" },
        "avatar-reviewer": { "verdict_fail": "surface_to_user" },
        "analogist": { "min_score": 6, "action": "drop_if_below" }
      }
    },
    {
      "stage": 3,
      "name": "Structure",
      "roles": ["outliner"],
      "parallel": false,
      "gate": { "min_score": 7, "action": "send_back" }
    },
    {
      "stage": 3.5,
      "name": "Emotional Design",
      "roles": ["emotional-architect"],
      "parallel": false,
      "gate": { "min_score": 7, "action": "surface_to_user" }
    },
    {
      "stage": 4,
      "name": "Draft",
      "roles": ["drafter"],
      "parallel": false,
      "gate": { "min_score": 7, "action": "send_back" }
    },
    {
      "stage": 5,
      "name": "Attack + Reaction",
      "roles": ["skeptic", "avatar-reviewer:pass-2"],
      "parallel": true,
      "gate": null
    },
    {
      "stage": 6,
      "name": "Polish",
      "roles": ["line-editor"],
      "parallel": false,
      "gate": { "min_score": 9, "action": "surface_to_user" }
    },
    {
      "stage": 7,
      "name": "Compression Test",
      "roles": ["compression-agent"],
      "parallel": false,
      "gate": { "compression_pass": true, "action": "surface_to_user" }
    }
  ],
  "total_roles": 10,
  "avg_min_score": null,
  "runs": 0
}
